# ========================================================
# 1. Google Sheets Configuration (Live Skills Database)
# ========================================================
# Option A (Recommended): Google Sheet ID
# Create a Google Sheet, share it as "Anyone with the link can view",
# and extract the ID from the URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_GID=0

# Option B: Direct CSV Export / Publish to Web URL
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?output=csv

# Note: If no Google Sheet env variables are configured, the app automatically
# falls back to the static skills in lib/skills.ts without breaking.


# ========================================================
# 2. Google Sheets Report Webhook (Automatic Reports Tab)
# ========================================================
# Connect user reports directly into the "report" tab of your Google Sheet:
# In your Google Sheet: Extensions -> Apps Script -> Paste Web App Script -> Deploy as Web App
GOOGLE_SHEET_REPORT_URL=https://script.google.com/macros/s/your_apps_script_id/exec

# ========================================================
# 3. Optional Email SMTP Configuration for Reports
# ========================================================
REPORT_RECEIVER_EMAIL=your_email@gmail.com

# SMTP Sender Configuration (e.g., using Gmail App Password)
# If using Gmail:
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=465
#   - SMTP_USER=your-sender-gmail@gmail.com
#   - SMTP_PASS=your-16-character-app-password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_app_password
